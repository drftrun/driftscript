node_modules/
dist/
*.log
.DS_Store
*.local

# The grammar the VSCode client contributes is copied from the generated one at package time.
# Committing it would be a second definition of the language, and `scripts/editors.test.mjs`
# fails if one appears.
editors/vscode/syntaxes/
editors/vscode/out/

# Agent scratch: holds git worktrees, which are whole checkouts of this repository.
.claude/

# The changelog is written into each package by `npm run build`, from the one at the root.
# Two hand-maintained copies is how one of them goes stale.
packages/*/CHANGELOG.md
