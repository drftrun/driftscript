{
  "name": "driftscript-language",
  "version": "1.11.0",
  "description": "The DriftScript language server: it calls the compiler and re-implements no part of it",
  "license": "MIT",
  "author": "Drift Technologies",
  "homepage": "https://script.driftengine.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drftrun/driftscript.git",
    "directory": "packages/driftscript-language"
  },
  "bugs": {
    "url": "https://github.com/drftrun/driftscript/issues"
  },
  "keywords": [
    "driftscript",
    "language-server",
    "lsp",
    "editor-tooling",
    "diagnostics",
    "completion"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "driftscript-language": "./dist/bin/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.mjs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs driftscript-language"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "driftscript": "1.11.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
